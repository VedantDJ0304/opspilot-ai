# OpsPilot AI — Python Backend Environment Variables
# Copy this to .env and fill in your values

# ── Gemini AI ───────────────────────────────────────────────────────────────
# Required for AI-powered reasoning. Get yours at https://aistudio.google.com
GEMINI_API_KEY="AQ.Ab8RN6IYrnqXhUiOzeW5rvUpWbYNuJ7ek8HZ7TutfX9PyBRUeA"
GEMINI_MODEL=gemini-2.5-flash

# ── Database ─────────────────────────────────────────────────────────────────
# Development (SQLite - zero setup required):
DATABASE_URL=sqlite+aiosqlite:///./opspilot.db

# Production (PostgreSQL/Supabase):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/opspilot

# ── Server ───────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Agent ────────────────────────────────────────────────────────────────────
AGENT_ENABLED=true
AGENT_MONITOR_INTERVAL_SECONDS=30
